# Copy to .env (git-ignored) and fill in. Never commit real values.

# Chat LLM — the only paid API. Claude by default:
ANTHROPIC_API_KEY=
# ...or swap providers with one env change (any langchain init_chat_model spec):
# PAPERTRACE_CHAT_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=

# Postgres (compose-internal defaults are fine for local dev)
POSTGRES_USER=papertrace
POSTGRES_PASSWORD=papertrace
POSTGRES_DB=papertrace

# Langfuse tracing for SOURCE-MODE dev only (uvicorn/bun on the host).
# The compose api container ignores these and uses service DNS + dev keys.
# LANGFUSE_HOST=http://localhost:3002
# LANGFUSE_PUBLIC_KEY=pk-lf-papertrace-dev
# LANGFUSE_SECRET_KEY=sk-lf-papertrace-dev
